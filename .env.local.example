# URL e chave pública (anon) do seu projeto Supabase.
# Encontre em: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Chave de serviço (service role) — usada apenas em scripts server-side
# (ex: scripts/seed.ts). NUNCA exponha esta chave no cliente/navegador.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role

# URL pública da aplicação (usada em links de e-mail de recuperação de senha)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
